# _inbox 是可重建的暂存区，归档进 taxonomy 后才入库
content/_inbox/
__pycache__/
*.pyc
# 派生索引（FTS/向量），由 scripts 重建
indexes/

# Obsidian 会话状态（每次启动都变，不跟踪）
content/.obsidian/workspace.json

# 阅读器软删除的回收站（瞬态）
content/_trash/

# 便携 Python 运行时与本地嵌入模型（机器本地，可重建）
.python/
app/rag_models/
# reading.db 本地滚动备份（复习进度是用户数据，但二进制不入 git；由 daily_backup 每日滚动）
backups/

# ---------- Agent / 工作流产物（不入库）----------
# QwenWork Canvas 会话工作区（含设计稿、doT.min.js、.design.json、.canvas-meta.json 等）
qwenwork/
# 上一代 QoderWork 客户端本地配置（mcp.json 等）
.qoder-cn/
# Cowork / Agent 会话临时目录
.cowork-temp/
# Box-Agent 会话产物（任务注册表等）
.box-agent/
# 日期戳 + 哈希的一次性 agent 会话目录（例如 2026-09-10-428af70d/）
20??-??-??-*/
# 巡检脚本产出的 _probe 前缀文档（不属于知识语料，是测试记录）
content/**/_probe*.md
# WorkBuddy 客户端本地工作目录（会话配置、缓存，机器本地）
.workbuddy/
# 常见 agent 草稿脚本（若散落在仓库根）
.refactor*.js
.body-*.html
.render-*.html
.sec-*.html
.splice.js
.cleanup.js

# pip/重定向误建文件（如 `pip install "numpy>=4.25.8"` 少写引号）与本地一次性脚本/日志
/=[0-9]*
/scripts/_batch*.log
# Node 工具链（ESLint/stylelint devDependencies；Agent 2026-09-13 引入）
node_modules/


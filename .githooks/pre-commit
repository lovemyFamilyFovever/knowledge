#!/bin/sh
# 知库 pre-commit：提交前自动跑四套测试（存在对应运行时才跑对应套件）
# 启用：git config core.hooksPath .githooks

# 逐个候选尝试，取第一个能 `import flask` 的解释器。
# 候选顺序：项目自带 .python 便携运行时**优先**——它装齐了含 RAG 在内的全部依赖，
# 与 start.bat 的行为一致（AGENTS 不变量 8）。PATH 里的 python 放后面兜底：
# 它可能只装了 flask 而缺 onnxruntime，钩子会在 RAG smoke 上炸
# （2026-09-13 GitHub Desktop 实测：其 sh 环境 PATH 命中的 python 无 RAG 依赖）。
# 不能用 `command -v python` 直接采信：本机默认 python 可能指向另一个没装 Flask 的
# 运行时，钩子会一跑就挂，最后只能靠人肉改 PATH 绕过 —— 那等于没有钩子。
PY=""
for cand in \
  ".python/python.exe" \
  "python" \
  "py -3" \
  "C:/Users/Administrator/AppData/Local/Programs/Python/Python313/python.exe" \
  "python3"
do
  # 候选可能带参数（如 `py -3`），故不加引号；不存在时命令自然失败，走下一个
  if $cand -c "import flask" >/dev/null 2>&1; then
    PY="$cand"
    break
  fi
done

if [ -z "$PY" ]; then
  echo "[pre-commit] 错误：以上候选里没有一个 Python 能 import flask，无法验证改动。"
  echo "[pre-commit] 请装上依赖（pip install flask）或把可用解释器加进本文件的候选清单。"
  exit 1
fi
echo "[pre-commit] using interpreter: $PY"

# 回归安全网（bug-assessment 2026-09-17 教训）：F821 未定义名这类笔误会被
# except Exception 吞成静默错数，smoke 测试拦不住，必须静态拦。ruff.toml
# 自述定位就是“回归安全网”，不跑等于没有。
echo "[pre-commit] running ruff (regression net)..."
$PY -m ruff check . || exit 1

# 调用处一律用**不加引号**的 $PY：候选里 `py -3` 带参数，需要分词才能展开成
# `py` + `-3`；加了引号会被当成一整个可执行文件名而找不到。
# （候选清单里的路径都不含空格，分词是安全的。）

echo "[pre-commit] running reader smoke..."
$PY tests/test_reader.py || exit 1

if [ -f "tests/test_new_project.py" ]; then
  echo "[pre-commit] running scaffolder smoke..."
  $PY tests/test_new_project.py || exit 1
fi

if [ -f "tests/test_learn.py" ]; then
  echo "[pre-commit] running learn/review smoke..."
  $PY tests/test_learn.py || exit 1
fi

if [ -f "tests/test_govern.py" ]; then
  echo "[pre-commit] running govern/stats smoke..."
  $PY tests/test_govern.py || exit 1
fi

# JS/CSS 静态检查（P1 补漏 2026-09-23）：此前 static/kb-novel.js 整份漏出 eslint 覆盖面，
# 且钩子完全不跑 eslint/stylelint。依赖是 devDependencies(node_modules) 而非 pip，
# 所以单独探测：缺 node/npm 或缺 node_modules 就打 SKIP 继续——绝不让钩子因环境问题
# 一跑就挂（历史教训：钩子挂 = 等于没有钩子）。文件清单以 package.json 的 lint:js 为
# 唯一事实源，不在这里重复维护一份。
if command -v node >/dev/null 2>&1 && command -v npm >/dev/null 2>&1 && [ -d "node_modules" ]; then
  echo "[pre-commit] running eslint (npm run lint:js)..."
  npm run --silent lint:js || exit 1
  echo "[pre-commit] running stylelint (npm run lint:css)..."
  npm run --silent lint:css || exit 1
else
  echo "[pre-commit] SKIP eslint/stylelint: node/npm or node_modules not available."
fi

# 悬空令牌检查（批6 整行删除回归教训）：var() 使用必须有定义/fallback/运行时注入兜底，
# 差集非空即拒绝提交。纯标准库，不依赖 flask，与上方解释器探测解耦。
echo "[pre-commit] running dangling-token check..."
$PY scripts/check_dangling_tokens.py || exit 1

echo "[pre-commit] running RAG smoke (SKIP if deps missing)..."
$PY tests/test_rag.py || exit 1

echo "[pre-commit] all green."
exit 0

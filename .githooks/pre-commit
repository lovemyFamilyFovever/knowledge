#!/bin/sh
# 知库 pre-commit：提交前自动跑四套测试（存在对应运行时才跑对应套件）
# 启用：git config core.hooksPath .githooks

# 逐个候选尝试，取第一个能 `import flask` 的解释器。
# 候选顺序：项目自带 .python 便携运行时**优先**——它装齐了含 RAG 在内的全部依赖，
# 与 start.bat 的行为一致（AGENTS 不变量 8）。PATH 里的 python 放后面兜底：
# 它可能只装了 flask 而缺 onnxruntime，钩子会在 RAG smoke 上炸
# （2026-09-13 GitHub Desktop 实测：其 sh 环境 PATH 命中的 python 无 RAG 依赖）。
# 不能用 `command -v python` 直接采信：本机默认 python 可能指向另一个没装 Flask 的
# 运行时，钩子会一跑就挂，最后只能靠人肉改 PATH 绕过 —— 那等于没有钩子。
PY=""
for cand in \
  ".python/python.exe" \
  "python" \
  "py -3" \
  "C:/Users/Administrator/AppData/Local/Programs/Python/Python313/python.exe" \
  "python3"
do
  # 候选可能带参数（如 `py -3`），故不加引号；不存在时命令自然失败，走下一个
  if $cand -c "import flask" >/dev/null 2>&1; then
    PY="$cand"
    break
  fi
done

if [ -z "$PY" ]; then
  echo "[pre-commit] 错误：以上候选里没有一个 Python 能 import flask，无法验证改动。"
  echo "[pre-commit] 请装上依赖（pip install flask）或把可用解释器加进本文件的候选清单。"
  exit 1
fi
echo "[pre-commit] using interpreter: $PY"

# 回归安全网（bug-assessment 2026-09-17 教训）：F821 未定义名这类笔误会被
# except Exception 吞成静默错数，smoke 测试拦不住，必须静态拦。ruff.toml
# 自述定位就是“回归安全网”，不跑等于没有。
echo "[pre-commit] running ruff (regression net)..."
$PY -m ruff check . || exit 1

# 调用处一律用**不加引号**的 $PY：候选里 `py -3` 带参数，需要分词才能展开成
# `py` + `-3`；加了引号会被当成一整个可执行文件名而找不到。
# （候选清单里的路径都不含空格，分词是安全的。）

echo "[pre-commit] running reader smoke..."
$PY tests/test_reader.py || exit 1

# 判定谓词层（P6 变异测试按存活清单回填的断言：store/fts 的布尔与边界判据）
if [ -f "tests/test_predicates.py" ]; then
  echo "[pre-commit] running predicate smoke..."
  $PY tests/test_predicates.py || exit 1
fi

# 性质测试（彻查 P3）：路径校验 / frontmatter 往返 / 改名守恒 / 双链 / 切块 / 排程 的任意输入不变量
if [ -f "tests/test_properties.py" ]; then
  echo "[pre-commit] running property tests..."
  $PY tests/test_properties.py || exit 1
fi

# JS 侧性质测试（彻查 P3-B）：畸形 epub / 任意字节 txt / 任意章节文本喂进**真浏览器**
# （临时 KB_ROOT + 临时实例 + CDP）。书库解析线（decodeTxt / normalizeEpubBytes /
# buildChapters）的三个历史线上 bug 全在这里，Python 侧够不着。
# 探测留给脚本自己做（缺 node 或 Chrome 就打 SKIP 并返回 0）——钩子挂 = 没有钩子。
if [ -f "tests/test_js_props.py" ]; then
  echo "[pre-commit] running JS property tests (browser, SKIP if no node/Chrome)..."
  $PY tests/test_js_props.py || exit 1
fi

# 视觉回归批处理（彻查 P5）：只在本次提交真的碰了 CSS/JS/模板时才跑——
# 它要起浏览器（约 40s），每次提交都跑会让人开始 --no-verify。
# 基线在 tests/ui-baselines/（合成语料截图，不含任何真实内容）；矩阵或样式变了用
# `python tests/test_ui_regress.py --update` 重新落基线，改前先用 --stability 证明截图是确定的。
UI_STAGED=$(git diff --cached --name-only --diff-filter=ACMR -- 'static/*.css' 'static/*.js' 'app/templates/*.html' | head -1)
if [ -n "$UI_STAGED" ]; then
  echo "[pre-commit] UI files staged -> running visual regression (P5)..."
  $PY tests/test_ui_regress.py || exit 1
else
  echo "[pre-commit] SKIP visual regression: no css/js/template file staged."
fi

if [ -f "tests/test_new_project.py" ]; then
  echo "[pre-commit] running scaffolder smoke..."
  $PY tests/test_new_project.py || exit 1
fi

if [ -f "tests/test_learn.py" ]; then
  echo "[pre-commit] running learn/review smoke..."
  $PY tests/test_learn.py || exit 1
fi

if [ -f "tests/test_govern.py" ]; then
  echo "[pre-commit] running govern/stats smoke..."
  $PY tests/test_govern.py || exit 1
fi

# JS/CSS 静态检查（P1 补漏 2026-09-23）：此前 static/kb-novel.js 整份漏出 eslint 覆盖面，
# 且钩子完全不跑 eslint/stylelint。依赖是 devDependencies(node_modules) 而非 pip，
# 所以单独探测：缺 node/npm 或缺 node_modules 就打 SKIP 继续——绝不让钩子因环境问题
# 一跑就挂（历史教训：钩子挂 = 等于没有钩子）。文件清单以 package.json 的 lint:js 为
# 唯一事实源，不在这里重复维护一份。
if command -v node >/dev/null 2>&1 && command -v npm >/dev/null 2>&1 && [ -d "node_modules" ]; then
  echo "[pre-commit] running eslint (npm run lint:js)..."
  npm run --silent lint:js || exit 1
  echo "[pre-commit] running stylelint (npm run lint:css)..."
  npm run --silent lint:css || exit 1
else
  echo "[pre-commit] SKIP eslint/stylelint: node/npm or node_modules not available."
fi

# 不变量门禁（P2）：AGENTS.md 的 8 条不变量落成可执行断言（tests/test_invariants.py），
# 与下方 rag-version 静态检查配套 —— 前者管行为（软删/唯一真相/`_` 目录不进索引…），
# 后者管"改了切块分词却忘递增 RAG_CODE_VERSION"这种只有静态能拦的形态。
if [ -f "tests/test_invariants.py" ]; then
  echo "[pre-commit] running invariants gate..."
  $PY tests/test_invariants.py || exit 1
fi

# 端到端端点冒烟（P4）：把覆盖台账 §1 的 58 个路由全打一遍（含 25 个此前零覆盖的
# 写类接口），断 2xx / ok:true / 磁盘状态真变 / 非法入参 4xx 且不泄露绝对路径。
# tempfile 迷你语料，零网络、零端口、约 3s，可直接进钩子。
if [ -f "tests/test_e2e_smoke.py" ]; then
  echo "[pre-commit] running e2e endpoint smoke..."
  $PY tests/test_e2e_smoke.py || exit 1
fi

# 已知缺陷回归锚（P4 发现 → 修复轮转绿后接入）：空子域 /browse 500、
# resolve 前缀分歧致 /api/rmdir · /api/import 500。P4 轮曾故意不挂（红断言会卡死
# 每次提交），两条改绿后接入 —— 若被重新引入，提交即被拦下。
if [ -f "tests/test_known_defects.py" ]; then
  echo "[pre-commit] running known-defects regression..."
  $PY tests/test_known_defects.py || exit 1
fi

# 悬空令牌检查（批6 整行删除回归教训）：var() 使用必须有定义/fallback/运行时注入兜底，
# 差集非空即拒绝提交。纯标准库，不依赖 flask，与上方解释器探测解耦。
# 台账对账（轮次 17 补）：§0 的最新数字必须等于按 §1~§5「状态」列重算的数。
# 起因是 §6 第 21 行那次事故——回填时改错了列，§0 写着 76、表格算出来是 81，
# 手写数没有任何一格在表格里背书。纯文本解析、零依赖、毫秒级，所以无条件跑。
echo "[pre-commit] running ledger reconciliation..."
$PY scripts/check_ledger_counts.py || exit 1

echo "[pre-commit] running dangling-token check..."
$PY scripts/check_dangling_tokens.py || exit 1

# RAG_CODE_VERSION 静态检查（不变量 7）：切块/分词函数体有改动而版本号未递增 → 拒绝。
# 自己判 SKIP：非 git 仓库/读不到 HEAD 时放行，不因环境问题挂钩子。
echo "[pre-commit] running RAG_CODE_VERSION check..."
$PY scripts/check_rag_version.py || exit 1

echo "[pre-commit] running RAG smoke (SKIP if deps missing)..."
$PY tests/test_rag.py || exit 1

echo "[pre-commit] all green."
exit 0
